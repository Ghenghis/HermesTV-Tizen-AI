# Claude working files
.claude/

# Environment / secrets — never commit real values
.env
.env.*
!.env.example
**/.env.hermestv
**/.env.local
*.authkey
*.key
*.pem
*.p12
*.pfx
secrets/
private/

# Docker env files
docker/**/.env
docker/**/secrets/

# Node
node_modules/
dist/
build/
.parcel-cache/
.vite/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Tizen build artifacts
*.wgt
tizen-build/
.tizen/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Logs (never commit logs that may contain provider data)
logs/
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/

# VPS audit raw runs — contain hostname + container inventory, kept local.
# The numbered summary doc (docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md) carries
# only what is safe to share.
docs/research/vps-phase-1-audit-RUN-*.md

# Playwright MCP scrape artifacts (browser console logs, page snapshots,
# screenshots from MCP-driven scrapes). These accumulate locally as side
# effects of running playwright tests and should never be committed.
.playwright-mcp/

# Playwright test runtime output (HTML reports, traces, screenshots, run state).
# These are produced on every test run and never belong in source control.
tests/playwright/test-results/
tests/playwright/report/

# Wave-20: operator provider credentials live in the API container's writable
# data/ volume — never committed to git. The lib/providerStore.js write path
# also chmod's the file to 0600 on POSIX.
services/hermes-tv-api/data/providers.json
services/hermes-tv-api/data/providers.json.tmp-*
