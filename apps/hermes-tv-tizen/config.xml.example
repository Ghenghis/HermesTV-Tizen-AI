<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://ghenghis/hermestv-tizen" version="0.1.0" viewmodes="maximized">
  <tizen:application id="HermesTV.HermesTV" package="HermesTV01" required_version="6.5"/>
  <content src="index.html"/>

  <!-- ─── Features ──────────────────────────────────────────────────────────
       Only declare features we actually need at runtime. Each feature widens
       the Samsung Seller-Office reviewer scope, so keep this list tight.
       Per docs/IPTV_Player_Zero/SAMSUNG_TIZEN_PORT.md §config.xml: internet
       + screen-size are mandatory for a 1080p TV web app. -->
  <feature name="http://tizen.org/feature/screen.size.normal.1920.1080"/>
  <feature name="http://tizen.org/feature/network.internet"/>

  <!-- ─── Icon ──────────────────────────────────────────────────────────────
       icon.png is gitignored (so each operator can drop in a branded asset
       without polluting the repo) and is regenerated as a 117×117 placeholder
       by tools/tizen-prep.js when missing. For production builds, ship a
       512×512 PNG with transparent background — Tizen's launcher rescales
       to the tile size of the target model (Q7 = 256×256, modern QLED =
       117×117 default + 512×512 high-DPI). Path is relative to widget root. -->
  <icon src="icon.png"/>
  <name>DaveTV</name>
  <tizen:profile name="tv"/>

  <!-- ─── Splash ────────────────────────────────────────────────────────────
       Solid dark background (#0b0d10 — matches the app's zero-shell BG)
       prevents the white flash Tizen would otherwise paint while the
       React bundle parses. orientation locked to landscape so the splash
       never rotates on a TV that was last left in a portrait kiosk mode. -->
  <tizen:splash-screens>
    <tizen:splash-screen src="icon.png" type="img" dpi="hdpi"
                         orientation="landscape" indicator="disable"
                         background-color="#0b0d10"/>
  </tizen:splash-screens>

  <!-- ─── Settings ──────────────────────────────────────────────────────────
       background-support="disable": app yields the foreground when the user
       navigates away (paired with tizenLifecycle.js, which detaches the
       <video> on visibilitychange so Tizen reclaims decoder slots cleanly).
       hwkey-event="enable": route the OS Back key to the page so our
       installTizenKeyHandler can cascade through the modal stack instead of
       the OS hard-exiting the app.
       screen-orientation="landscape": Q7 QLED is fixed landscape; locking
       here prevents an accidental rotation during sleep/wake. Baseline
       viewport is the panel native 1920×1080 (declared via the index.html
       <meta name="viewport"> the Vite build emits — Tizen has no
       widget-level viewport attribute). -->
  <tizen:setting screen-orientation="landscape" context-menu="disable"
                 background-support="disable" encryption="disable"
                 install-location="auto" hwkey-event="enable"/>

  <!-- ─── Access origins ───────────────────────────────────────────────────
       Tizen rejects HTTP/WS requests to hosts not listed here. The list is
       intentionally narrow — only the canonical VPS, its alias, and an
       explicit LAN-dev escape hatch. tv.daveai.tech is now the canonical
       short URL; hermestv.daveai.tech remains a valid alias so existing
       .wgt installs and any cached references continue to work. -->
  <access origin="https://tv.daveai.tech" subdomains="true"/>
  <access origin="https://hermestv.daveai.tech" subdomains="true"/>
  <!-- Local dev access: only used when localStorage override
       'hermestv.api_base' (or ?api=<url> query string) points to LAN. -->
  <access origin="http://localhost" subdomains="true"/>

  <!-- ─── Privileges ────────────────────────────────────────────────────────
       Each privilege is reviewed at install time. We add only what the app
       actually exercises so Samsung Seller-Office doesn't reject the build.
         internet           : fetch() to the VPS
         network.get        : read connectivity state (Settings panel badge)
         tv.audio           : tizen.tvaudiocontrol for volume / mute UI sync
         tv.inputdevice     : tizen.tvinputdevice.registerKey for transport
                              / channel / color / numpad keys (see
                              apps/hermes-web-tv/src/utils/tizenKeyMap.js).
         mediaplaylist      : reserved for future AVPlay queue work; safe to
                              leave declared because AVPlay calls fall back
                              to silent failure if the privilege is missing.
         avplay (Samsung)   : window.webapis.avplay — the Samsung-specific
                              media-controller used by useAvplayStream.js
                              for native HLS playback on Tizen. Without
                              this, AVPlay calls throw and the hook drops
                              through to the hls.js fallback. See
                              AVPLAY_INTEGRATION.md for the state machine.
         keymanager         : tizen.keymanager — token-bearing playback
                              URLs (the /api/play ticket flow) cache the
                              short-lived JWT here instead of localStorage
                              so the value can't be read by a hostile page
                              loaded via the QR onboarding flow. -->
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/network.get"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/mediaplaylist"/>
  <tizen:privilege name="http://tizen.org/privilege/keymanager"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>

  <!-- ─── Content Security Policy ──────────────────────────────────────────
       Tizen's strict mode rejects 'unsafe-eval' and we have none in the
       Vite output — keep it that way. 'unsafe-inline' for style-src is
       still required because React inlines style attributes via JSX.
       'unsafe-inline' for script-src is additionally required because the
       Vite bundle emits an inline `__vite__mapDeps` initializer and a
       module-preload polyfill stub.
       connect-src must list every host the app fetches from at runtime:
         - tv.daveai.tech / hermestv.daveai.tech : the VPS (canonical +
           legacy alias; both kept so cached installs still resolve).
         - api.cognitive.microsofttranslator.com : Azure translator.
         - *.cognitiveservices.azure.com         : Azure TTS / speech.
         The Azure entries are present even though the VPS proxies most
         calls today — direct-from-TV fallback is allowed for the boot
         greeting when the VPS round-trip would add audible latency.
       media-src includes Azure TTS blob origins explicitly so the
       <audio src="blob:..."> URLs produced by azureVoiceClient resolve. -->
  <tizen:content-security-policy>
    default-src 'self' https://tv.daveai.tech https://hermestv.daveai.tech;
    connect-src 'self' https://tv.daveai.tech https://hermestv.daveai.tech wss://tv.daveai.tech wss://hermestv.daveai.tech https://api.cognitive.microsofttranslator.com https://*.cognitiveservices.azure.com;
    script-src 'self' 'unsafe-inline';
    style-src 'self' 'unsafe-inline';
    img-src 'self' data: blob: http: https:;
    media-src 'self' blob: http: https: https://tv.daveai.tech https://hermestv.daveai.tech https://*.cognitiveservices.azure.com;
    font-src 'self' data:;
    object-src 'none';
    frame-ancestors 'none';
  </tizen:content-security-policy>
</widget>
