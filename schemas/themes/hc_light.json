{
  "theme_id": "hc_light",
  "version": "1.0.0",
  "name": "High Contrast Light",
  "family": "accessibility",
  "intent": "Near-white background with near-black text and magenta focus ring — WCAG AAA compliant",
  "tokens": {
    "bg_0": "#F5F5F5",
    "bg_1": "#EBEBEB",
    "bg_2": "#E0E0E0",
    "surface_0": "#D8D8D8",
    "surface_1": "#CCCCCC",
    "text_primary": "#111111",
    "text_secondary": "#333333",
    "text_disabled": "#888888",
    "accent": "#111111",
    "accent_hover": "#E91E8C",
    "accent_pressed": "#C0166E",
    "focus_ring": "#E91E8C",
    "focus_ring_pressed": "#C0166E",
    "ok": "#1B5E20",
    "warn": "#BF6000",
    "danger": "#B00020",
    "badge_quality_4k": "#4A148C",
    "badge_quality_1080": "#0D47A1",
    "badge_quality_720": "#37474F",
    "badge_quality_low": "#888888",
    "badge_provider": "#1B5E20",
    "shadow_strong": "rgba(0,0,0,0.35)"
  },
  "typography": {
    "font_family_primary": "Inter, Samsung One, system-ui",
    "font_family_display": "Inter, Samsung One, system-ui",
    "scale_base_px": 26,
    "scale_step": 1.125
  },
  "focus_ring": {
    "style": "static_thick",
    "thickness_px": 6,
    "glow_enhanced_only": false
  },
  "wcag_target": "AAA",
  "high_contrast_partner": null,
  "mom_mode_partner": "mom_calm",
  "default_background_pack": "morning_light_01",
  "proof_required": ["contrast_audit", "screenshot_per_layout", "focus_ring_visibility", "wcag_aaa_report"]
}
