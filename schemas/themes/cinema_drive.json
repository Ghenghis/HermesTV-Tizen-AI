{
  "theme_id": "cinema_drive",
  "version": "1.0.0",
  "name": "Cinema Drive",
  "family": "cinema",
  "intent": "Night-dark background with cyan-blue accent for night drive retro feel",
  "tokens": {
    "bg_0": "#080808",
    "bg_1": "#101010",
    "bg_2": "#181818",
    "surface_0": "#1E1E1E",
    "surface_1": "#252525",
    "text_primary": "#EAF4FF",
    "text_secondary": "#90B8D8",
    "text_disabled": "#405870",
    "accent": "#40C4FF",
    "accent_hover": "#64D2FF",
    "accent_pressed": "#0099CC",
    "focus_ring": "#FFD86B",
    "focus_ring_pressed": "#FFB300",
    "ok": "#3EC97A",
    "warn": "#F5A524",
    "danger": "#FF5A5A",
    "badge_quality_4k": "#9F7CFF",
    "badge_quality_1080": "#40C4FF",
    "badge_quality_720": "#9CB0C9",
    "badge_quality_low": "#405870",
    "badge_provider": "#3EC97A",
    "shadow_strong": "rgba(0,0,0,0.70)"
  },
  "typography": {
    "font_family_primary": "Inter, Samsung One, system-ui",
    "font_family_display": "Inter, Samsung One, system-ui",
    "scale_base_px": 22,
    "scale_step": 1.125
  },
  "focus_ring": {
    "style": "static_thick",
    "thickness_px": 4,
    "glow_enhanced_only": true
  },
  "high_contrast_partner": "hc_dark",
  "mom_mode_partner": "mom_calm",
  "default_background_pack": "night_drive_01",
  "proof_required": ["contrast_audit", "screenshot_per_layout", "focus_ring_visibility"]
