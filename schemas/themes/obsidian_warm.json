{
  "theme_id": "obsidian_warm",
  "version": "1.0.0",
  "name": "Obsidian Warm",
  "family": "dark",
  "intent": "Warm dark background with amber accent for cozy evening viewing",
  "tokens": {
    "bg_0": "#120E0A",
    "bg_1": "#1A1410",
    "bg_2": "#22190F",
    "surface_0": "#271E13",
    "surface_1": "#2E2418",
    "text_primary": "#F3EDE5",
    "text_secondary": "#C4B49E",
    "text_disabled": "#7A6A58",
    "accent": "#E8A44A",
    "accent_hover": "#F0BA6E",
    "accent_pressed": "#C8852A",
    "focus_ring": "#FFD86B",
    "focus_ring_pressed": "#FFB300",
    "ok": "#3EC97A",
    "warn": "#F5A524",
    "danger": "#FF5A5A",
    "badge_quality_4k": "#9F7CFF",
    "badge_quality_1080": "#E8A44A",
    "badge_quality_720": "#9CB0C9",
    "badge_quality_low": "#7A6A58",
    "badge_provider": "#3EC97A",
    "shadow_strong": "rgba(0,0,0,0.55)"
  },
  "typography": {
    "font_family_primary": "Inter, Samsung One, system-ui",
    "font_family_display": "Inter, Samsung One, system-ui",
    "scale_base_px": 22,
    "scale_step": 1.125
  },
  "focus_ring": {
    "style": "static_thick",
    "thickness_px": 4,
    "glow_enhanced_only": true
  },
  "high_contrast_partner": "hc_dark",
  "mom_mode_partner": "mom_calm",
  "default_background_pack": "static_warm_dark",
  "proof_required": ["contrast_audit", "screenshot_per_layout", "focus_ring_visibility"]
