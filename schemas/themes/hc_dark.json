{
  "theme_id": "hc_dark",
  "version": "1.0.0",
  "name": "High Contrast Dark",
  "family": "accessibility",
  "intent": "Pure black background with pure white text and yellow focus ring — WCAG AAA compliant",
  "tokens": {
    "bg_0": "#000000",
    "bg_1": "#0A0A0A",
    "bg_2": "#141414",
    "surface_0": "#1A1A1A",
    "surface_1": "#222222",
    "text_primary": "#FFFFFF",
    "text_secondary": "#E0E0E0",
    "text_disabled": "#909090",
    "accent": "#FFFFFF",
    "accent_hover": "#FFD700",
    "accent_pressed": "#E0C000",
    "focus_ring": "#FFD700",
    "focus_ring_pressed": "#E0C000",
    "ok": "#00E676",
    "warn": "#FFD700",
    "danger": "#FF1744",
    "badge_quality_4k": "#FFFFFF",
    "badge_quality_1080": "#E0E0E0",
    "badge_quality_720": "#B0B0B0",
    "badge_quality_low": "#909090",
    "badge_provider": "#00E676",
    "shadow_strong": "rgba(0,0,0,0.90)"
  },
  "typography": {
    "font_family_primary": "Inter, Samsung One, system-ui",
    "font_family_display": "Inter, Samsung One, system-ui",
    "scale_base_px": 26,
    "scale_step": 1.125
  },
  "focus_ring": {
    "style": "static_thick",
    "thickness_px": 6,
    "glow_enhanced_only": false
  },
  "wcag_target": "AAA",
  "high_contrast_partner": null,
  "mom_mode_partner": "mom_calm",
  "default_background_pack": "static_dark_default",
  "proof_required": ["contrast_audit", "screenshot_per_layout", "focus_ring_visibility", "wcag_aaa_report"]
}
