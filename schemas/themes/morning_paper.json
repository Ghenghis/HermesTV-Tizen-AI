{
  "theme_id": "morning_paper",
  "version": "1.0.0",
  "name": "Morning Paper",
  "family": "light",
  "intent": "Off-white background with charcoal text and blue accent for daytime reading",
  "tokens": {
    "bg_0": "#F9F6F0",
    "bg_1": "#F2EEE6",
    "bg_2": "#EAE5DC",
    "surface_0": "#E2DDD3",
    "surface_1": "#D8D2C8",
    "text_primary": "#2C2C2C",
    "text_secondary": "#5A5652",
    "text_disabled": "#A09A94",
    "accent": "#1565C0",
    "accent_hover": "#1976D2",
    "accent_pressed": "#0D47A1",
    "focus_ring": "#1565C0",
    "focus_ring_pressed": "#0D47A1",
    "ok": "#2E7D32",
    "warn": "#E65100",
    "danger": "#C62828",
    "badge_quality_4k": "#4A148C",
    "badge_quality_1080": "#1565C0",
    "badge_quality_720": "#546E7A",
    "badge_quality_low": "#A09A94",
    "badge_provider": "#2E7D32",
    "shadow_strong": "rgba(0,0,0,0.25)"
  },
  "typography": {
    "font_family_primary": "Inter, Samsung One, system-ui",
    "font_family_display": "Inter, Samsung One, system-ui",
    "scale_base_px": 22,
    "scale_step": 1.125
  },
  "focus_ring": {
    "style": "static_thick",
    "thickness_px": 4,
    "glow_enhanced_only": false
  },
  "high_contrast_partner": "hc_light",
  "mom_mode_partner": "mom_calm",
  "default_background_pack": "morning_light_01",
  "proof_required": ["contrast_audit", "screenshot_per_layout", "focus_ring_visibility"]
}
