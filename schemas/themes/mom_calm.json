{
  "theme_id": "mom_calm",
  "version": "1.0.0",
  "name": "Mom Calm",
  "family": "accessibility",
  "intent": "Warm soft dark background with amber accent and large text — Mom's default theme (mom_tv only)",
  "tokens": {
    "bg_0": "#1A1410",
    "bg_1": "#221A15",
    "bg_2": "#2A211C",
    "surface_0": "#30271F",
    "surface_1": "#382E25",
    "text_primary": "#F5EDE6",
    "text_secondary": "#CCBCB0",
    "text_disabled": "#806E62",
    "accent": "#E07B39",
    "accent_hover": "#F08C4A",
    "accent_pressed": "#C06028",
    "focus_ring": "#FFD86B",
    "focus_ring_pressed": "#FFB300",
    "ok": "#3EC97A",
    "warn": "#F5A524",
    "danger": "#FF5A5A",
    "badge_quality_4k": "#9F7CFF",
    "badge_quality_1080": "#E07B39",
    "badge_quality_720": "#9CB0C9",
    "badge_quality_low": "#806E62",
    "badge_provider": "#3EC97A",
    "shadow_strong": "rgba(0,0,0,0.55)"
  },
  "typography": {
    "font_family_primary": "Inter, Samsung One, system-ui",
    "font_family_display": "Inter, Samsung One, system-ui",
    "scale_base_px": 28,
    "scale_step": 1.125
  },
  "focus_ring": {
    "style": "static_thick_high_contrast",
    "thickness_px": 5,
    "glow_enhanced_only": false
  },
  "profile_lock": "mom_tv",
  "high_contrast_partner": "hc_dark",
  "mom_mode_partner": null,
  "default_background_pack": "warm_ambient_01",
  "proof_required": ["contrast_audit", "screenshot_per_layout", "focus_ring_visibility"]
}
