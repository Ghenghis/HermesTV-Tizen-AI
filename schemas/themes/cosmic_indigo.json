{
  "theme_id": "cosmic_indigo",
  "version": "1.0.0",
  "name": "Cosmic Indigo",
  "family": "dark",
  "intent": "Deep indigo background with cyan accent evoking outer space",
  "tokens": {
    "bg_0": "#0A0A1F",
    "bg_1": "#0E0E2A",
    "bg_2": "#141435",
    "surface_0": "#181840",
    "surface_1": "#1E1E4C",
    "text_primary": "#EAF0FF",
    "text_secondary": "#9AAACE",
    "text_disabled": "#4A5080",
    "accent": "#00E5FF",
    "accent_hover": "#18EBFF",
    "accent_pressed": "#00B8D4",
    "focus_ring": "#FFD86B",
    "focus_ring_pressed": "#FFB300",
    "ok": "#3EC97A",
    "warn": "#F5A524",
    "danger": "#FF5A5A",
    "badge_quality_4k": "#9F7CFF",
    "badge_quality_1080": "#00E5FF",
    "badge_quality_720": "#9CB0C9",
    "badge_quality_low": "#4A5080",
    "badge_provider": "#3EC97A",
    "shadow_strong": "rgba(0,0,0,0.65)"
