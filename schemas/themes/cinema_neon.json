  "tokens": {
    "bg_0": "#050510",
    "bg_1": "#0A0A1A",
    "bg_2": "#0F0F22",
    "surface_0": "#141430",
    "surface_1": "#1A1A3C",
    "text_primary": "#F0EEFF",
    "text_secondary": "#A090C0",
    "text_disabled": "#504060",
    "accent": "#FF007F",
    "accent_hover": "#FF3399",
    "accent_pressed": "#CC005F",
    "accent_secondary": "#00F5FF",
    "focus_ring": "#00F5FF",
    "focus_ring_pressed": "#00C8D4",
    "ok": "#3EC97A",
    "warn": "#F5A524",
    "danger": "#FF5A5A",
    "badge_quality_4k": "#FF007F",
    "badge_quality_1080": "#00F5FF",
    "badge_quality_720": "#9CB0C9",
    "badge_quality_low": "#504060",
