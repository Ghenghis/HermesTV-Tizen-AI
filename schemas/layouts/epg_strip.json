{
  "preset_id": "epg_strip",
  "version": "2.0.0",
  "name": "EPG Strip",
  "intent": "Horizontal time-grid EPG with mini preview pane — 2.5h window is the QN-class default",
  "tier_floor": "baseline",
  "grid": {
    "columns": 2,
    "rows": 1,
    "card_shape": "rounded_16_9"
  },
  "grid_note": "columns: epg 65%, preview 35%",
  "regions": ["top_bar", "epg_grid", "preview_pane"],
  "focus_order": ["epg_grid", "preview_pane", "top_bar"],
  "safe_area_pct": 5,
  "animation_density_default": "medium",
  "focus_ring_default": "animated_glow",
  "background_pack_default": "ambient_motion_01",
  "time_window_hours": 2.5,
  "visible_rows": 8,
  "un_degradation": {
    "note": "UN-class Crystal UHD TVs may use this reduced mode. Performance not guaranteed.",
    "font_scale": 1.0,
    "focus_ring": "static_thick",
    "animation_density": "low",
    "time_window_hours": 2,
    "visible_rows": 8
  },
  "mom_variant": {
    "font_scale": 1.35,
    "focus_ring": "static_thick_high_contrast",
    "animation_density": "off",
    "time_window_hours": 2.5,
    "visible_rows": 6,
    "audio_feedback": true
  },
  "proof_required": [
    "screenshot_qn",
    "screenshot_mom",
    "screenshot_un_degraded",
    "focus_traversal_log",
    "frame_budget_proof"
  ]
}
