{
  "preset_id": "recents_resume",
  "version": "2.0.0",
  "name": "Recents and Resume",
  "intent": "Resume watching rail + recent activity rail for returning viewers — animated focus and motion for QN-class",
  "tier_floor": "baseline",
  "grid": {
    "columns": 6,
    "rows": 2,
    "card_shape": "rounded_16_9"
  },
  "grid_note": "rows: resume + recent",
  "regions": ["top_bar", "resume_rail", "recent_rail"],
  "focus_order": ["resume_rail", "recent_rail", "top_bar"],
  "safe_area_pct": 5,
  "animation_density_default": "medium",
  "focus_ring_default": "animated_glow",
  "background_pack_default": "ambient_motion_01",
  "un_degradation": {
    "note": "UN-class Crystal UHD TVs may use this reduced mode. Performance not guaranteed.",
    "font_scale": 1.0,
    "tile_density": "medium",
    "focus_ring": "static_thick",
    "animation_density": "low",
    "columns_override": 4
  },
  "mom_variant": {
    "font_scale": 1.35,
    "tile_density": "large",
    "focus_ring": "static_thick_high_contrast",
    "animation_density": "off",
    "audio_feedback": true
  },
  "proof_required": [
    "screenshot_qn",
    "screenshot_mom",
    "screenshot_un_degraded",
    "focus_traversal_log",
    "frame_budget_proof"
  ]
}
