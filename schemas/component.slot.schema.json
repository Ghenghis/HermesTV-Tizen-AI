{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermestv.local/schemas/component.slot.schema.json",
  "title": "HermesTV Component Slot Config",
  "type": "object",
  "required": ["layout_id", "slots"],
  "properties": {
    "layout_id": { "type": "string" },
    "slots": {
      "type": "object",
      "properties": {
        "nav": { "type": "string" },
        "hero": { "type": "string" },
        "content": { "type": "string" },
        "detail": { "type": "string" },
        "mini_player": { "type": "string" }
      }
    }
  }
}
