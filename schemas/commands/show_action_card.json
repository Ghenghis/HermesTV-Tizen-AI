{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hermestv:commands:show_action_card",
  "title": "show_action_card params",
  "description": "Display an action card with user-confirmable options.",
  "type": "object",
  "required": ["title", "actions"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "body": {
      "type": "string",
      "maxLength": 256
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "action_id"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "style": {
            "type": "string",
            "enum": ["default", "primary", "danger"]
          }
        }
      }
    },
    "default_focus": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of action to focus by default. Defaults to 0."
    }
  }
}
