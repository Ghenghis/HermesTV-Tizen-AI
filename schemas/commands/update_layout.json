{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hermestv:commands:update_layout",
  "title": "update_layout params",
  "description": "Switch the active layout preset for a profile.",
  "type": "object",
  "required": ["layout_id"],
  "additionalProperties": false,
  "properties": {
    "layout_id": {
      "type": "string",
      "enum": [
        "grid-standard",
        "rail-hero",
        "jumbo-rail",
        "spotlight-hero",
        "editorial-grid",
        "channel-zapper",
        "series-shelf",
        "4k-showcase",
        "news-ticker",
        "sports-scoreboard",
        "kids-bubbles",
        "minimal-list"
      ],
      "description": "Layout preset ID. B2 supports: grid-standard, rail-hero, jumbo-rail."
    }
  }
}
