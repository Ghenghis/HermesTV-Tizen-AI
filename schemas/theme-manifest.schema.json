{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Ghenghis/HermesTV-Tizen-AI/schemas/theme-manifest.schema.json",
  "title": "HermesTV Theme Manifest",
  "description": "Theme definition for one of the 24 themes. See docs/05_THEME_BACKGROUND_ENGINE_CONTRACT.md.",
  "type": "object",
  "required": ["theme_id", "display_name", "tier", "colors", "typography", "motion"],
  "additionalProperties": false,
  "properties": {
    "theme_id": {
      "type": "string",
      "description": "Kebab-case theme identifier.",
      "pattern": "^[a-z0-9-]+$"
    },
    "display_name": { "type": "string", "maxLength": 64 },
    "tier": {
      "type": "string",
      "enum": ["baseline", "enhanced", "both"],
      "description": "Which TV tier this theme is available on. baseline=UN-class only. enhanced=QN-class only. both=all TVs."
    },
    "profile_default": {
      "type": ["string", "null"],
      "enum": ["dave_tv", "mom_tv", null],
      "description": "Which profile this theme is the default for. Null = not a default."
    },
    "colors": {
      "type": "object",
      "required": ["background", "surface", "on_surface", "accent", "badge_live", "badge_vod", "badge_series"],
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "on_surface": { "type": "string" },
        "accent": { "type": "string" },
        "badge_live": { "type": "string" },
        "badge_vod": { "type": "string" },
        "badge_series": { "type": "string" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["base_size_px", "scale_factor"],
      "additionalProperties": false,
      "properties": {
        "base_size_px": {
          "type": "integer",
          "minimum": 16,
          "description": "Base font size in px. Mom Mode floor: 1.25x applied on top."
        },
        "scale_factor": {
          "type": "number",
          "minimum": 1.0,
          "description": "Relative scale applied to base_size_px."
        },
        "font_family": { "type": "string" }
      }
    },
    "motion": {
      "type": "object",
      "required": ["density"],
      "additionalProperties": false,
      "properties": {
        "density": {
          "type": "string",
          "enum": ["none", "minimal", "standard", "rich"]
        },
        "reduced_motion_override": {
          "type": "boolean",
          "description": "When true, forces density=none regardless of theme default. Used for Mom Mode."
        }
      }
    },
    "background_pack_id": {
      "type": ["string", "null"],
      "description": "Default background pack for this theme. Null = solid color only."
    }
  }
}
