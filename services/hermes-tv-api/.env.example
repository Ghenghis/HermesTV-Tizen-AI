# Server runtime
NODE_ENV=production
PORT=3001

# ── Azure Cognitive Services — TTS ──
# Get a key from: https://portal.azure.com → Speech service → Keys and Endpoint
# These keys MUST stay on the VPS only. Never commit real values.
AZURE_TTS_KEY=your_azure_speech_key_here
AZURE_TTS_REGION=eastus

# ── Jellyfin (workstation Docker, accessed via Tailscale) ──
JELLYFIN_URL=http://jellyfin.workstation.local:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# ── IPTV M3U sources — provider URLs only, no Tizen client ever sees these ──
APOLLO_M3U_URL=
APOLLO_EPG_URL=
XTREMEHD_M3U_URL=
XTREMEHD_EPG_URL=

# ── XMLTV EPG source ──
# When XMLTV_URL is set, /api/epg returns real channel + program data parsed
# from this feed and cached for 5 minutes. When empty, /api/epg returns a
# stub. Public starter: https://iptv-org.github.io/epg/guides/us.xml.
# Operator-provided feeds may include credentials in the query string — those
# are never echoed in responses. See docs/44_EPG_XMLTV_SETUP.md.
XMLTV_URL=
# Set to 1 to allow ?force_refresh=1 to bypass the 5-min cache. Off by default
# so a LAN client can't force-fetch on every request.
EPG_ALLOW_FORCE_REFRESH=0

# ── Threadfin (M3U proxy running on this VPS) ──
THREADFIN_URL=http://threadfin:34400

# ── iptv-org (public community catalog, no credentials needed) ──
# When IPTV_ORG_ENABLED=true the API fetches https://iptv-org.github.io/api/
# JSON files (channels/streams/guides/logos/blocklist) once per 24h into
# IPTV_ORG_CACHE_DIR, and merges them into /api/catalog. Filtered by
# country + category whitelists below; NSFW + blocklist + closed channels
# always dropped. Stream URLs never leave the server.
IPTV_ORG_ENABLED=false
IPTV_ORG_COUNTRIES=US,GB,CA,AU
IPTV_ORG_CATEGORIES=general,news,sports,movies,entertainment,kids,documentary,lifestyle,music
IPTV_ORG_CACHE_DIR=/var/cache/iptv-org

# ── LLM / Agent backbone (for chatbot intelligence) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point at OpenAI proper (default) or any OpenAI-compatible endpoint
# (e.g. local Ollama, vLLM, an Anthropic-compatible proxy).
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name passed to the chat-completions endpoint. Whatever the configured
# endpoint accepts — e.g. gpt-4o-mini, llama-3.1-8b-instruct, etc.
LLM_DEFAULT_MODEL=

# ── CORS — comma-separated list of additional allowed origins ──
EXTRA_CORS_ORIGINS=

# ── Settings persistence ──
# File-backed per-profile settings store. Parent dir is created on boot.
# Inside the Docker container this is a mounted volume (see VPS_COMPOSE.yml,
# hermestv-vps-settings-store) so settings survive `docker compose up -d`.
# Local dev: leave as default or point at a tmp file under your home dir.
HERMES_SETTINGS_STORE=/var/lib/hermestv/settings.json
