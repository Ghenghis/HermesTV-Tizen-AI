# Server runtime
NODE_ENV=production
PORT=3001

# ── Azure Cognitive Services — TTS ──
# Get a key from: https://portal.azure.com → Speech service → Keys and Endpoint
# These keys MUST stay on the VPS only. Never commit real values.
AZURE_TTS_KEY=your_azure_speech_key_here
AZURE_TTS_REGION=eastus

# ── Jellyfin (workstation Docker, accessed via Tailscale) ──
JELLYFIN_URL=http://jellyfin.workstation.local:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# ── IPTV M3U sources — provider URLs only, no Tizen client ever sees these ──
APOLLO_M3U_URL=
APOLLO_EPG_URL=
XTREMEHD_M3U_URL=
XTREMEHD_EPG_URL=

# ── Threadfin (M3U proxy running on this VPS) ──
THREADFIN_URL=http://threadfin:34400

# ── LLM / Agent backbone (for chatbot intelligence) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point at OpenAI proper (default) or any OpenAI-compatible endpoint
# (e.g. local Ollama, vLLM, an Anthropic-compatible proxy).
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name passed to the chat-completions endpoint. Whatever the configured
# endpoint accepts — e.g. gpt-4o-mini, llama-3.1-8b-instruct, etc.
LLM_DEFAULT_MODEL=

# ── CORS — comma-separated list of additional allowed origins ──
EXTRA_CORS_ORIGINS=

# ── Settings persistence ──
# File-backed per-profile settings store. Parent dir is created on boot.
# Inside the Docker container this is a mounted volume (see VPS_COMPOSE.yml,
# hermestv-vps-settings-store) so settings survive `docker compose up -d`.
# Local dev: leave as default or point at a tmp file under your home dir.
HERMES_SETTINGS_STORE=/var/lib/hermestv/settings.json
