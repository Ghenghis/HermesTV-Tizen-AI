# ============================================================================
# HermesTV — host nginx site config (Cloudflare-Flexible / proxied edition)
#
# Pattern: Cloudflare proxies hermestv.daveai.tech → terminates TLS at edge →
# connects to this VPS over HTTP on port 80. Origin serves HTTP only.
# This matches the existing `hermes.daveai.tech`, `voice.daveai.tech`, and
# every other daveai.tech site already on this VPS — see
# docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md.
#
# Installation (sysadmin, after PR #8 merge + DNS A record + operator user):
#   sudo cp upstream/nginx/hermestv.daveai.tech.conf.example \
#           /etc/nginx/sites-available/hermestv.daveai.tech
#   sudo ln -s /etc/nginx/sites-available/hermestv.daveai.tech \
#              /etc/nginx/sites-enabled/
#   sudo nginx -t                         # MUST print "syntax is ok"
#   sudo systemctl reload nginx           # reload — NOT restart
#
# Rollback if anything regresses:
#   sudo rm /etc/nginx/sites-enabled/hermestv.daveai.tech
#   sudo nginx -t && sudo systemctl reload nginx
#
# Phase 1.5 reference: docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md
# ============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name hermestv.daveai.tech;

    # Security headers — Cloudflare also adds some; these are belt-and-braces.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Cloudflare → origin requests carry the real client IP in CF-Connecting-IP.
    # Set X-Real-IP from that header so upstream logs are useful.
    set_real_ip_from 0.0.0.0/0;
    real_ip_header CF-Connecting-IP;

    # --- API + health ---
    # HermesTV API container will bind host port 3011 once Phase 2 brings the
    # stack up. Until then, proxy_pass returns 502 — that is expected.
    location /api/ {
        proxy_pass http://127.0.0.1:3011/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3011/health;
        access_log off;
    }

    # --- TTS audio stream — longer timeout, no buffering ---
    location /api/tts/speak {
        proxy_pass http://127.0.0.1:3011/api/tts/speak;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 60s;
    }

    # --- Web app SPA ---
    # hermes-web-tv container (nginx serving the Vite build) will bind host
    # port 3080 once Phase 2 brings the stack up.
    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # --- Cache policy for static assets ---
    location ~* \.(js|css|png|jpg|jpeg|ico|svg|woff2?)$ {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- Refuse direct public access to internal admin UIs ---
    # Threadfin, m3u-editor, xtreamfilter are operator-only via Tailscale.
    location ~ ^/(threadfin|m3u-editor|xtreamfilter)/ {
        return 403;
    }

    client_max_body_size 4m;
}

# ============================================================================
# Verification after install (curl from workstation, NOT from VPS):
#
#   curl -I https://hermestv.daveai.tech/         # 502 expected pre-Phase-2
#   curl -I https://hermestv.daveai.tech/health   # 502 expected pre-Phase-2
#   curl -I https://hermes.daveai.tech/           # must remain 200 (unchanged)
#   curl -I https://daveai.tech/                  # must remain 200 (unchanged)
#   curl -I https://voice.daveai.tech/            # must remain 200 (unchanged)
#
# 502 from hermestv.daveai.tech is correct before Phase 2 deploy — the
# upstream containers are not yet listening on 3011 / 3080. nginx itself is
# healthy; the empty upstream is expected.
# ============================================================================
