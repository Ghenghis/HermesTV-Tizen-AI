# ============================================================================
# HermesTV — host nginx site config (Cloudflare-Flexible / proxied edition)
#
# Pattern: Cloudflare proxies tv.daveai.tech AND hermestv.daveai.tech →
# terminates TLS at edge → connects to this VPS over HTTP on port 80. Origin
# serves HTTP only. This matches the existing `hermes.daveai.tech`,
# `voice.daveai.tech`, and every other daveai.tech site already on this
# VPS — see docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md.
#
# Canonical / alias: `tv.daveai.tech` is the new short canonical URL.
# `hermestv.daveai.tech` is kept as an additive alias so existing bookmarks,
# QR codes, and links never break. Both server_name entries below resolve
# to the same upstream — Cloudflare's universal cert covers *.daveai.tech
# so no origin cert change is required.
#
# Installation (sysadmin, after PR #8 merge + DNS A record + operator user):
#   sudo cp upstream/nginx/hermestv.daveai.tech.conf.example \
#           /etc/nginx/sites-available/hermestv.daveai.tech
#   sudo ln -s /etc/nginx/sites-available/hermestv.daveai.tech \
#              /etc/nginx/sites-enabled/
#   sudo nginx -t                         # MUST print "syntax is ok"
#   sudo systemctl reload nginx           # reload — NOT restart
#
# Rollback if anything regresses:
#   sudo rm /etc/nginx/sites-enabled/hermestv.daveai.tech
#   sudo nginx -t && sudo systemctl reload nginx
#
# Phase 1.5 reference: docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md
# ============================================================================

server {
    listen 80;
    listen [::]:80;
    # Additive: serve both the new short canonical AND the historical
    # subdomain. Bookmarks, QR codes, and external links targeting
    # hermestv.daveai.tech continue to work indefinitely.
    server_name tv.daveai.tech hermestv.daveai.tech;

    # Security headers — Cloudflare also adds some; these are belt-and-braces.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Cloudflare → origin requests carry the real client IP in CF-Connecting-IP.
    # Set X-Real-IP from that header so upstream logs are useful.
    set_real_ip_from 0.0.0.0/0;
    real_ip_header CF-Connecting-IP;

    # --- API + health ---
    # HermesTV API container will bind host port 3011 once Phase 2 brings the
    # stack up. Until then, proxy_pass returns 502 — that is expected.
    location /api/ {
        proxy_pass http://127.0.0.1:3011/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3011/health;
        access_log off;
    }

    # --- TTS audio stream — longer timeout, no buffering ---
    location /api/tts/speak {
        proxy_pass http://127.0.0.1:3011/api/tts/speak;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 60s;
    }

    # --- Web app SPA ---
    # hermes-web-tv container (nginx serving the Vite build) will bind host
    # port 3080 once Phase 2 brings the stack up.
    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # --- Cache policy for static assets ---
    location ~* \.(js|css|png|jpg|jpeg|ico|svg|woff2?)$ {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- Refuse direct public access to internal admin UIs ---
    # Threadfin, m3u-editor, xtreamfilter are operator-only via Tailscale.
    location ~ ^/(threadfin|m3u-editor|xtreamfilter)/ {
        return 403;
    }

    client_max_body_size 4m;
}

# ============================================================================
# Verification after install (curl from workstation, NOT from VPS):
#
#   curl -I https://tv.daveai.tech/               # canonical — must return 200
#   curl -I https://tv.daveai.tech/health         # canonical — must return 200
#   curl -I https://hermestv.daveai.tech/         # alias — must return same as canonical
#   curl -I https://hermestv.daveai.tech/health   # alias — must return same as canonical
#   curl -I https://hermes.daveai.tech/           # must remain 200 (unchanged)
#   curl -I https://daveai.tech/                  # must remain 200 (unchanged)
#   curl -I https://voice.daveai.tech/            # must remain 200 (unchanged)
#
# Both tv.daveai.tech AND hermestv.daveai.tech must answer — the alias is
# additive, not a redirect. Any divergence (200 on one, 502 on the other)
# means the server_name line in the server{} block above is mis-edited.
# ============================================================================
