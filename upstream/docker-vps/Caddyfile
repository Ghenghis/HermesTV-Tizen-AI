{
  email {$ACME_EMAIL}
  servers {
    protocols h1 h2 h3
  }
}

{$PUBLIC_DOMAIN} {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }

  @api path /api/* /health
  handle @api {
    # Phase 1.5: HermesTV API moved 3001 → 3011 (port 3001 already bound on VPS
    # by Dave's next-server). See docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md.
    reverse_proxy hermes-tv-api:3011 {
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  @threadfin path /threadfin/*
  handle @threadfin {
    reverse_proxy threadfin:34400
  }

  handle {
    reverse_proxy hermes-web-tv:80
  }
}
