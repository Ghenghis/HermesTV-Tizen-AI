# ============================================================================
# HermesTV VPS — environment template
# Copy to .env on the Hostinger VPS, fill values, NEVER commit the real .env.
# ============================================================================

# ── Server runtime ──
NODE_ENV=production
# Phase 1.5: HermesTV API on VPS uses 3011 (3001 already bound by Dave's
# next-server). See docs/20_VPS_PHASE_1_AUDIT_FINDINGS.md.
# Local dev (npm run dev outside Docker) still uses 3001 by convention.
PORT=3011
# tv.daveai.tech is the canonical short URL (added 2026-05-18).
# hermestv.daveai.tech remains a valid alias on the VPS nginx server_name
# line; bookmarks and QR codes targeting the older name still work.
PUBLIC_HOST=tv.daveai.tech

# ── DaveTV invite-only auth ──
# Required for the public web app. The first admin must be Dave.
DAVETV_AUTH_REQUIRED=true
# Protect every non-auth API route with a DaveTV session cookie.
DAVETV_AUTH_ENFORCE_API=true
DAVETV_AUTH_STORE=/var/lib/hermestv/auth.json
DAVETV_PUBLIC_APP_URL=https://tv.daveai.tech
DAVETV_ADMIN_EMAIL=
DAVETV_ADMIN_PASSWORD=
# SMTP for invite/reset emails. If omitted, the admin panel returns a link
# for Dave to send manually; it does not claim an email was sent.
DAVETV_SMTP_HOST=
DAVETV_SMTP_PORT=587
DAVETV_SMTP_SECURE=false
DAVETV_SMTP_STARTTLS=true
DAVETV_SMTP_FROM=
DAVETV_SMTP_USER=
DAVETV_SMTP_PASS=
# OAuth buttons are hidden unless the matching real credentials are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SAMSUNG_CLIENT_ID=
SAMSUNG_CLIENT_SECRET=
SAMSUNG_AUTH_URL=
SAMSUNG_TOKEN_URL=
SAMSUNG_USERINFO_URL=
SAMSUNG_SCOPE=openid email profile

# ── Azure Cognitive Services — TTS ──
# https://portal.azure.com → Speech service → Keys and Endpoint
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
# Also accepted for compatibility with existing private vaults:
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# ── Jellyfin (workstation, reached over Tailscale from this VPS) ──
JELLYFIN_URL=http://workstation-tailscale-ip:8096
JELLYFIN_API_KEY=

# ── IPTV M3U providers (server only — never sent to client) ──
APOLLO_M3U_URL=
APOLLO_EPG_URL=
APOLLO_USERNAME=
APOLLO_PASSWORD=

XTREMEHD_M3U_URL=
XTREMEHD_EPG_URL=
XTREMEHD_USERNAME=
XTREMEHD_PASSWORD=

# ── Threadfin (this VPS) ──
THREADFIN_URL=http://threadfin:34400

# ── iptv-org (public community catalog, no credentials needed) ──
# Enabled by default so DaveTV has free public channels before paid
# providers are added. Stream URLs stay server-side behind /api/play.
IPTV_ORG_ENABLED=true
IPTV_ORG_COUNTRIES=US,GB,CA,AU
IPTV_ORG_CATEGORIES=general,news,sports,movies,entertainment,kids,documentary,lifestyle,music
IPTV_ORG_CACHE_DIR=/var/cache/iptv-org

# ── m3u-editor / xtreamfilter (this VPS) ──
M3U_EDITOR_URL=http://m3u-editor:4200
XTREAMFILTER_URL=http://xtreamfilter:3456

# ── LLM / Agent (server-side chatbot intelligence) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001

# ── CORS — comma-separated additional origins beyond defaults ──
# Default allowed: localhost, hermestv.local, any 192.168.x.x.
# Add both the canonical (tv.daveai.tech) and the alias (hermestv.daveai.tech)
# for production so any client typing either Host header is accepted.
EXTRA_CORS_ORIGINS=https://tv.daveai.tech,https://hermestv.daveai.tech

# ── Caddy domain ──
# tv.daveai.tech is the canonical short URL (added 2026-05-18).
# hermestv.daveai.tech remains an additive nginx server_name alias.
# The bare hermes.daveai.tech is in use by another app and is off-limits.
PUBLIC_DOMAIN=tv.daveai.tech
ACME_EMAIL=admin@daveai.tech

# ── Xtream Codes paid-panel direct API (preferred over M3U). When all three
# are set, the API pulls live/VOD/series via player_api.php and proxies all
# streams server-side. Per docs/46_PROVIDER_TRUTH_PROOF_CONTRACT.md these
# stay server-side only and never appear in any /api/* response body.
XTREAM_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# ── Provider registry directory (persistent across container restarts).
# Mounted via the hermestv-vps-providers-store named volume in VPS_COMPOSE.
# The producer is /api/providers + /setup/provider/submit + the optional
# durable-mode pairing-complete payload. File is 0600, .gitignored, and
# carries credentials for operator-added providers only — env-derived
# providers (the *_M3U_URL / XTREAM_* / JELLYFIN_* / IPTV_ORG_ENABLED vars
# above) stay in env and are never written to this file.
HERMES_PROVIDER_DATA_DIR=/var/lib/hermestv/providers
